<CycloneDDS>
    <Domain>
        <General>
            <!-- Define which network interface to use -->
            <Interfaces>
                <NetworkInterface name="enp0s31f6" priority="2" presence_required="true" />
                <!-- <NetworkInterface name="br0" priority="1" presence_required="false" /> -->
            </Interfaces>

            <MaxMessageSize>1400B</MaxMessageSize>

            <!-- Explicitly allow/control multicast -->
            <AllowMulticast>true</AllowMulticast>

            <!-- Optional: Change the multicast group if you have collisions -->
            <!--<MulticastGroupAddress>239.255.0.1</MulticastGroupAddress>-->
        </General>

        <Discovery>
            <!-- Force discovery to use multicast -->
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>500</MaxAutoParticipantIndex>
        </Discovery>
    </Domain>
</CycloneDDS>