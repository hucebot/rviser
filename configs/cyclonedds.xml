<CycloneDDS>
    <Domain>
        <General>
            <!-- Define which network interface to use -->
            <Interfaces>
                <NetworkInterface name="enxd43a65190b83" priority="2" presence_required="true" />
                <NetworkInterface name="lo" priority="1" presence_required="false" />
            </Interfaces>

      <!-- Explicitly allow/control multicast -->
      <AllowMulticast>false</AllowMulticast>

      <!-- Optional: Change the multicast group if you have collisions -->
    </General>
    <Discovery>
      <!-- Force discovery to use multicast -->
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
          <Peer Address="10.68.0.1"/>
          <Peer Address="10.68.0.42"/>
          <Peer Address="localhost"/>
      </Peers>
      <MaxAutoParticipantIndex>99</MaxAutoParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>